# =========================================================
# Cache-Control para o Netlify
# =========================================================
# Garantia que os usuários SEMPRE carregam o index.html mais
# recente quando há um deploy. O index.html aponta pros assets
# com hash no nome (ex: /assets/index-DDX1GaL1.js), então quando
# o index é fresh, o user busca o bundle JS novo automaticamente.
#
# Sem isso, navegadores podem manter um index.html cacheado por
# horas/dias e nunca carregar a versão nova do app.
# =========================================================

# index.html nunca cacheado: sempre busca o último deploy
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Mesma coisa pra rota raiz
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Assets têm hash no nome (Vite garante) — pode cachear forte
/assets/*
  Cache-Control: public, max-age=31536000, immutable
